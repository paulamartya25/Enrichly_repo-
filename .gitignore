# Enrichly Job Automation Platform – .gitignore

# .NET
*.user
*.suo
.vs/
bin/
obj/
*.dll
*.exe
*.pdb
*.nupkg
*.snupkg
project.lock.json
project.fragment.lock.json
artifacts/
**/Properties/launchSettings.json

# Environment files (NEVER commit secrets)
.env
.env.local
.env.*.local
backend/.env
backend/src/JobAutomation.Api/.env

# Frontend
node_modules/
frontend/.next/
frontend/out/
frontend/.env.local
frontend/.env.development.local
frontend/.env.test.local
frontend/.env.production.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Docker
.docker/

# macOS
.DS_Store

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# JetBrains IDEs
.idea/
*.iml

# VS Code
.vscode/
!.vscode/extensions.json

# Test results
TestResults/
coverage/
*.coverage
*.coveragexml
